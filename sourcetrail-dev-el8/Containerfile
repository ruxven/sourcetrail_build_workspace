# Use a modern, stable RHEL derivative
FROM rockylinux:8

# Install necessary build tools and dependencies using dnf (RHEL package manager)
RUN dnf install -y 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled devel && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y \
    gcc-c++ \
    cmake \
    git \
    python3 \
    python3-pip \
    wget \
    tar \
    qt5-qtbase-devel \
    qt5-qtsvg-devel \
    boost-static \
    clang-devel \
    llvm-devel \
    llvm-static \
    java-1.8.0-openjdk-devel \
    maven \
    libffi-devel \
    libxml2-devel

RUN dnf clean all

ARG LLVM_VERSION=10.0.0

ENV LLVM_SRC_TAR_XZ=llvm-$LLVM_VERSION.src.tar.xz
ENV CLANG_SRC_TAR_XZ=clang-$LLVM_VERSION.src.tar.xz

RUN wget -q https://github.com/llvm/llvm-project/releases/download/llvmorg-$LLVM_VERSION/llvm-$LLVM_VERSION.src.tar.xz -O /tmp/$LLVM_SRC_TAR_XZ && \
    wget -q https://github.com/llvm/llvm-project/releases/download/llvmorg-$LLVM_VERSION/clang-$LLVM_VERSION.src.tar.xz -O /tmp/$CLANG_SRC_TAR_XZ && \
    echo "Fetched LLVM packages"
RUN mkdir /usr/local/src -p && tar --no-same-owner -xf /tmp/$LLVM_SRC_TAR_XZ -C /usr/local/src && \
    mkdir -p /tmp/llvm-${LLVM_VERSION}.src/tools && \
    tar --no-same-owner -xf /tmp/$CLANG_SRC_TAR_XZ -C /usr/local/src/llvm-${LLVM_VERSION}.src/tools && \
    echo "Extracted LLVM packages" 
RUN cd /usr/local/src/llvm-${LLVM_VERSION}.src/tools && \
    mv clang-${LLVM_VERSION}.src clang && \
    \
    cd /usr/local/src/llvm-${LLVM_VERSION}.src && \
    mkdir -p build && \
    cd build && \
    cmake -G "Unix Makefiles" \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_TARGETS_TO_BUILD=host \
        -DLLVM_ENABLE_RTTI=ON \
        .. && \
    make -j$(nproc) && \
    \
    make install && \
    rm /tmp/$LLVM_SRC_TAR_XZ /tmp/$CLANG_SRC_TAR_XZ

ARG USERNAME=developer
ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID --shell /bin/bash --create-home $USERNAME

RUN mkdir -p /build && chown $USER_UID:$USER_GID /build
WORKDIR /build
USER $USERNAME

CMD ["/bin/bash"]
