#!/bin/bash -e

source .env

if [[ "clean" = "$1" ]]; then
  pushd sourcetrail_el8
  git clean -f -x -d
  popd
  exit 0
fi

echo "Building the application inside the container"
CMD=$1
if [[ -z "$CMD" ]]; then
  CMD="/build/scripts/build_sourcetrail_el8"
fi

if [[ "docker" == "${CONTAINER_TOOL}" ]]; then
${CONTAINER_TOOL} run \
  -it \
  --rm \
  -v "$(pwd):/build" sourcetrail-dev-el8:latest "$CMD"
else
${CONTAINER_TOOL} run \
  -it \
  --rm \
  --userns=keep-id \
  -v "$(pwd):/build:Z" sourcetrail-dev-el8:latest "$CMD"
fi

echo "Build of sourcetrail completed successfully"
